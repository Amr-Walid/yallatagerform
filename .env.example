# ==========================================================================
# Yalla Tager - Environment Variables Template
# انسخ هذا الملف إلى ".env" ثم عدّل القيم حسب بيئتك
#   cp .env.example .env
# ==========================================================================

# ----- Server -----
PORT=3000
NODE_ENV=development

# ----- Storage driver -----
# auto  : يحاول SQL Server أولاً ثم يرجع لملفات JSON المحلية (مناسب للتطوير)
# mssql : SQL Server إلزامي (الإنتاج) - يتوقف السيرفر إذا فشل الاتصال
# file  : ملفات JSON محلية فقط (تشغيل سريع بدون قاعدة بيانات)
DB_DRIVER=auto

# ----- SQL Server -----
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=YallaTagerForm
DB_USER=sa
DB_PASSWORD=YourStrongPassword
DB_CONNECTION_TIMEOUT=15000
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# ----- Security -----
JWT_SECRET=change-this-to-a-long-random-secret

# ----- Default admin (seeded on first run only) -----
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=YallaTagerAdmin2026

# ==========================================================================
# Merchant lookup service (خدمة الاستعلام عن التاجر)
# ==========================================================================
# يستخدمها مسار "عميل يلا تاجر": المستخدم يدخل رقم هاتفه فنستعلم عن
# حالة التكويد الخاصة به. LOOKUP_API_KEY إلزامي - بدونه يرجع /api/lookup
# خطأ 503 دون كشف تفاصيل الإعداد للمستخدم.
LOOKUP_API_URL=https://endpoints.svei.tech/api/YTGOnline/CheckMerchantForCoding
LOOKUP_API_KEY=

# نافذة الخصوصية بالأيام: يُعرض سجل التاجر فقط إذا كان تاريخ إنشائه
# من اليوم وراجع هذا العدد من الأيام. أقدم من ذلك => "عذراً تعذر عرض البيانات"
# القرار يُتخذ في السيرفر ولا تصل البيانات المحجوبة للمتصفح إطلاقاً.
LOOKUP_RECENT_DAYS=7

# مهلة الاتصال بالسيرفيس الخارجي (ملي ثانية)
LOOKUP_TIMEOUT_MS=15000

# ==========================================================================
# Rate limiting (بديل الكابتشا التي تم إزالتها)
# ==========================================================================
# /api/lookup مفتوح للعامة، لذلك نحدّ من عدد الاستعلامات لمنع
# تعداد أرقام الهواتف (enumeration).
LOOKUP_RATE_WINDOW_MS=60000
LOOKUP_RATE_MAX=15

# POST /api/merchants - حد إرسال طلبات التسجيل
SUBMIT_RATE_WINDOW_MS=600000
SUBMIT_RATE_MAX=10

# ----- مراقبة الأمان والاستعلامات (Security Monitoring) -----
# تبويب "مراقبة الأمان والاستعلامات" في لوحة الأدمن.
# النافذة الزمنية التي يُحلَّل النشاط داخلها (افتراضي 15 دقيقة)
SEC_WINDOW_MS=900000
# أقصى عدد أحداث محفوظة في ذاكرة العملية
SEC_MAX_EVENTS=1500
# أقصى عدد عناوين IP متتبَّعة (يُزاح الأقدم عند الامتلاء)
SEC_MAX_ACTORS=3000

# مهم عند النشر خلف Nginx / Cloudflare: بدون الثقة في الوكيل ستظهر كل
# الزيارات بنفس عنوان الـ IP فيفقد النظام قدرته على تمييز المهاجم.
# اضبطها على false فقط إذا كان التطبيق مكشوفاً مباشرة بدون وكيل.
TRUST_PROXY=1

# ----- SMTP (activation emails) -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Yalla Tager" <no-reply@yallatager.com>
